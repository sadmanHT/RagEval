# Core
RAGEVAL_APP_ENV=development
RAGEVAL_LOG_LEVEL=INFO
RAGEVAL_QDRANT_URL=http://localhost:6333
RAGEVAL_REDIS_URL=redis://localhost:6379/0

# Providers default to deterministic/offline-safe choices in Phase 1.
RAGEVAL_EMBEDDING_PROVIDER=fake
RAGEVAL_RERANKER_PROVIDER=fake
RAGEVAL_GENERATION_PROVIDER=fake
RAGEVAL_TRACING_PROVIDER=disabled
RAGEVAL_EXPERIMENT_PROVIDER=disabled

# Hosted-provider credentials (only required when the matching provider is selected).
RAGEVAL_OPENAI_API_KEY=
RAGEVAL_ANTHROPIC_API_KEY=
RAGEVAL_COHERE_API_KEY=
RAGEVAL_LANGFUSE_PUBLIC_KEY=
RAGEVAL_LANGFUSE_SECRET_KEY=
RAGEVAL_LANGFUSE_HOST=https://cloud.langfuse.com
RAGEVAL_WANDB_API_KEY=
RAGEVAL_WANDB_PROJECT=rag-eval
