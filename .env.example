# Core
RAGEVAL_APP_ENV=development
RAGEVAL_LOG_LEVEL=INFO
RAGEVAL_QDRANT_URL=http://localhost:6333
RAGEVAL_QDRANT_COLLECTION_BASE=rageval_dense
RAGEVAL_QDRANT_COLLECTION_VERSION=v1
RAGEVAL_REDIS_URL=redis://localhost:6379/0

# Phase 13 serving. Always replace the API key outside local examples.
RAGEVAL_SERVING_API_KEY=
RAGEVAL_SERVING_REQUEST_TIMEOUT_SECONDS=30
RAGEVAL_SERVING_MAX_REQUEST_BYTES=65536
RAGEVAL_SERVING_QUERY_CONCURRENCY=16
RAGEVAL_SERVING_EVAL_JOB_CONCURRENCY=1
RAGEVAL_SERVING_EVAL_QUEUE_SIZE=8
RAGEVAL_SERVING_CACHE_TTL_SECONDS=300
RAGEVAL_SERVING_EXPOSE_RETRIEVAL_DIAGNOSTICS=false
RAGEVAL_SERVING_STREAM_CHUNK_CHARS=256

# Providers default to deterministic/offline-safe choices.
RAGEVAL_EMBEDDING_PROVIDER=fake
RAGEVAL_EMBEDDING_MODEL=text-embedding-3-large
RAGEVAL_EMBEDDING_DIMENSIONS=3072
RAGEVAL_LOCAL_EMBEDDING_DIMENSIONS=64
RAGEVAL_OPENAI_BASE_URL=https://api.openai.com/v1
RAGEVAL_RERANKER_PROVIDER=fake
RAGEVAL_GENERATION_PROVIDER=fake
RAGEVAL_TRACING_PROVIDER=disabled
RAGEVAL_EXPERIMENT_PROVIDER=disabled

# Hosted-provider credentials (only required when the matching provider is selected).
RAGEVAL_OPENAI_API_KEY=
RAGEVAL_ANTHROPIC_API_KEY=
RAGEVAL_COHERE_API_KEY=
RAGEVAL_LANGFUSE_PUBLIC_KEY=
RAGEVAL_LANGFUSE_SECRET_KEY=
RAGEVAL_LANGFUSE_HOST=https://cloud.langfuse.com
RAGEVAL_WANDB_API_KEY=
RAGEVAL_WANDB_PROJECT=rag-eval
